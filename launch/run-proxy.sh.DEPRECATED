echo "run-proxy.sh is DEPRECATED — use launch/run-undercut.sh (injected TcpIn sniffer) instead." >&2
echo "If you really need the legacy proxy, edit this script to remove the guard." >&2
exit 1

# Legacy command (the login MITM proxy in :tools):
./gradlew :tools:run -PmainClass=org.darkan.tools.loginproxy.LoginProxyKt
